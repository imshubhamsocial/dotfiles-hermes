# Ignore runtime databases and binary files
**/*.db
**/*.db-wal
**/*.db-shm
**/*.log
**/*.lock

# Ignore runtime caches, sandboxes, and transient state
.hermes/cache/**
.hermes/backups/**
.hermes/dot_curator_backups/**
.hermes/desktop/**
.hermes/guardrails/**
.hermes/images/**
.hermes/lsp/**
.hermes/openviking/**
.hermes/pastes/**
.hermes/private_audio_cache/**
.hermes/private_hooks/**
.hermes/private_image_cache/**
.hermes/private_logs/**
.hermes/private_pairing/**
.hermes/private_sessions/**
.hermes/runtime/**
.hermes/sandboxes/**
.hermes/spawn-trees/**
.hermes/terminal-sessions/**
.hermes/*_cache.json*
.hermes/dot_update_check
.hermes/dot_hermes_history
.hermes/dot_skills_prompt_snapshot.json
.hermes/processes.json
.hermes/tui-theme-boot.json
.hermes/environment.json
