#!/usr/bin/env bash
# Hardware-Optimized llama-server Launcher for Gemma-4-4B
# GPU: NVIDIA RTX 3050 Laptop (6GB VRAM)

HERMES_ROOT="/var/home/imshubhamsocial/Projects/Workspace/Personal/hermes"
SITE_PACKAGES="${HERMES_ROOT}/.local/lib/python3.13/site-packages"
LLAMA_LIB_DIR="${HERMES_ROOT}/bin/llama"

export LD_LIBRARY_PATH="${LLAMA_LIB_DIR}:${SITE_PACKAGES}/nvidia/cu13/lib:${SITE_PACKAGES}/nvidia/cublas/lib:${SITE_PACKAGES}/nvidia/cuda_nvrtc/lib:${SITE_PACKAGES}/nvidia/nccl/lib:${SITE_PACKAGES}/nvidia/cuda_runtime/lib:${LD_LIBRARY_PATH:-}"

MODEL_MAIN="${HERMES_ROOT}/assets/gguf/gemma-4-E4B-it-Q4_K_M.gguf"
SERVER_BIN="${HERMES_ROOT}/bin/llama/llama-server.bin"

exec "$SERVER_BIN" \
    --model "$MODEL_MAIN" \
    -ngl 99 \
    --flash-attn on \
    --jinja \
    -c 65536 \
    --cache-type-k q4_0 \
    --cache-type-v q4_0 \
    --threads 6 \
    --threads-batch 6 \
    --host 127.0.0.1 \
    --port 8138 \
    --metrics \
    "$@"
