{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "root": false,
  "files": {
    "ignoreUnknown": true,
    "maxSize": 10485760,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.hermes_archived",
      "!**/.local_archived",
      "!**/.local",
      "!**/.venv",
      "!**/.cache",
      "!**/.config",
      "!**/.cua-driver",
      "!**/hermes-agent",
      "!**/cache",
      "!**/sessions",
      "!**/logs",
      "!**/skills",
      "!**/profiles",
      "!**/memories",
      "!**/*.jsonl",
      "!**/*cache*.json",
      "!**/*.html",
      "!**/venv",
      "!**/dist",
      "!**/build",
      "!**/tests",
      "!**/.git",
      "!**/runtime",
      "!**/desktop",
      "!**/*boot*.json",
      "!**/spawn-trees",
      "!**/.gemini",
      "!**/.npm",
      "!**/.openviking",
      "!**/.crawl4ai",
      "!**/.dspy_cache",
      "!**/.mem0",
      "!**/.ua",
      "!**/.hermes/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  }
}
