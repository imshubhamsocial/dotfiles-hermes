# Hermes NeMo Guardrails — Input Rails (Colang 2.x)
# Intercepts high-risk destructive shell commands and injection patterns

flow check critical commands
  user said "rm -rf /" or user said "rm -rf *" or user said "mkfs" or user said "dd if=/dev/zero" or user said "drop database" or user said ":(){ :|:& };:"
  bot say "Security Alert: Execution blocked by NeMo input rail. Destructive operational pattern detected."

flow check shell injection
  user said "; rm -rf /" or user said "&& rm -rf /" or user said "| nc -e /bin/bash" or user said "cat /etc/shadow"
  bot say "Security Alert: Command chaining or sandbox privilege escalation attempt blocked by NeMo input rail."
