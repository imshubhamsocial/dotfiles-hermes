# Hermes NeMo Guardrails — Output Rails
# Detects and redacts sensitive credentials, private keys, and API tokens

define bot leak credentials
  "sk-proj-1234567890abcdef"
  "AIzaSyAbc1234567890"
  "ghp_abcdefghijklmnopqrstuvwxyz0123456789"
  "AKIAIOSFODNN7EXAMPLE"
  "-----BEGIN RSA PRIVATE KEY-----"
  "-----BEGIN OPENSSH PRIVATE KEY-----"
  "-----BEGIN EC PRIVATE KEY-----"
  "-----BEGIN PRIVATE KEY-----"

define flow check sensitive data leakage
  bot leak credentials
  bot refuse credential leak
  stop

define bot refuse credential leak
  "Output Redacted: Sensitive credential or private key pattern blocked by NeMo output rail."
