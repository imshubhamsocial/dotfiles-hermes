define subflow check input entropy and injection
  $input_audit = execute check_input_security_action(text=$user_message)
  if not $input_audit.security_passed
    bot refuse unsafe input
    stop

define bot refuse unsafe input
  "SECURITY RAIL HALT: Input rejected by Phase 15 Proactive Security Gate (subshell injection, backtick escape, or Shannon entropy H > 4.6)."

define subflow check retrieved context integrity
  $rag_audit = execute check_retrieval_poisoning_action(chunks=$relevant_chunks)
  if not $rag_audit.passed
    bot refuse poisoned retrieval
    stop

define bot refuse poisoned retrieval
  "RETRIEVAL RAIL HALT: Retrieved memory or web chunk contained indirect prompt injection markers and was quarantined."

define subflow enforce u12 diff and tabu execution rail
  $exec_audit = execute enforce_u12_and_tabu_action(tool_name=$tool_name, diff_lines=$diff_lines, strike_count=$strike_count, ast_callers=$ast_callers, target_file=$target_file, workspace_dir=$workspace_dir)
  if $exec_audit.tabu_reverted
    bot notify tabu revert
    stop
  if not $exec_audit.u12_passed
    bot refuse u12 violation
    stop

define bot notify tabu revert
  "TABU STRIKE-2 RAIL HALT: Target file restored from write-once .turn1.bak shadow backup. Incremental patching halted; escalating to jev_decide / jev_anneal_cluster."

define bot refuse u12 violation
  "EXECUTION RAIL HALT: Proposed mutation exceeds Karpathy U12 surgical diff bound (> 15 lines for bug fix) or uses prohibited raw sed/awk."

define subflow verify epistemic closure and non vacuous receipt
  $out_audit = execute verify_epistemic_receipt_action(bot_response=$bot_message, last_tool_output=$last_tool_output, workspace_dir=$workspace_dir)
  if not $out_audit.verified
    bot refuse unverified completion
    stop

define bot refuse unverified completion
  "OUTPUT RAIL HALT: Epistemic closure rejected. Completion requires exitstatus == 0 in /tmp/hermes_verified_receipt.json and >= 1 executed test ('Ran 0 tests' is prohibited)."
