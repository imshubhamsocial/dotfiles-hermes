[Unit]  
Description=Hermes Agent OS 24/7 Autonomous RSI & Synthetic Gauntlet Daemon (GDR17)  
After=network.target hermes-llama-server.service hermes-openviking.service

[Service]  
Type=simple  
Environment="CUDA_VISIBLE_DEVICES="  
Environment="TMPDIR=/tmp"  
Environment="HERMES_WORKSPACE=/var/home/imshubhamsocial/Projects/Workspace/Personal/hermes"  
WorkingDirectory=/var/home/imshubhamsocial/Projects/Workspace/Personal/hermes  
ExecStart=/usr/bin/distrobox enter ws-hermes -- /usr/bin/python3.13 -u /var/home/imshubhamsocial/Projects/Workspace/Personal/hermes/.hermes/hermes_rsi_daemon.py  
Restart=always  
RestartSec=10  
MemoryMax=2G

[Install]  
WantedBy=default.target

