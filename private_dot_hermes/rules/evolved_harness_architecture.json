{
  "execution_policy": {
    "max_retries_per_node": 3,
    "context_token_ceiling": 350,
    "enable_ast_gate": true,
    "enable_lsp_diagnostics": true,
    "enable_cpu_embeddings": true,
    "dag_concurrency": 1,
    "timeout_sec": 30.0
  },
  "tool_routing": {
    "code_generation_tools": [
      "write_file",
      "patch",
      "read_file"
    ],
    "research_tools": [
      "web",
      "read_file",
      "search_files"
    ],
    "verification_tools": [
      "terminal",
      "oxlint",
      "pytest"
    ],
    "fallback_on_tool_failure": true
  },
  "negative_constraints": [],
  "active_ast_rules": [
    "syntax_gate",
    "scope_mutation_audit",
    "brace_balance",
    "duplicate_declarations"
  ],
  "web_research_triggers": [
    "SyntaxError",
    "ImportError",
    "TypeError",
    "ModuleNotFoundError"
  ]
}