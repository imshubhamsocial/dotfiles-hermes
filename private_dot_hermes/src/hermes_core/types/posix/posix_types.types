# POSIX C Type Definitions (seed — authoritative stubs for 4B SLM reference)
# Format: symbol_name: type signature (single line)

# File descriptors & I/O
int: int
ssize_t: signed size type
size_t: unsigned size type
off_t: file offset type
mode_t: file mode type
pid_t: process ID type
uid_t: user ID type
gid_t: group ID type

# epoll
epoll_event: struct { uint32_t events; epoll_data_t data; }
epoll_data_t: union { void *ptr; int fd; uint32_t u32; uint64_t u64; }
EPOLLIN: uint32_t (0x001)
EPOLLOUT: uint32_t (0x004)
EPOLLERR: uint32_t (0x008)
EPOLLHUP: uint32_t (0x010)

# sockets
sockaddr: struct { sa_family_t sa_family; char sa_data[14]; }
sockaddr_in: struct { sa_family_t sin_family; in_port_t sin_port; struct in_addr sin_addr; }
sockaddr_un: struct { sa_family_t sun_family; char sun_path[108]; }
SOCK_STREAM: int (1)
SOCK_DGRAM: int (2)
AF_INET: int (2)
AF_UNIX: int (1)

# memory & mmap
MAP_SHARED: int (0x01)
MAP_PRIVATE: int (0x02)
PROT_READ: int (0x01)
PROT_WRITE: int (0x02)
MAP_FAILED: void* ((void*)-1)

# pthreads
pthread_t: unsigned long
pthread_mutex_t: struct { int __data; }
pthread_cond_t: struct { int __data; }
PTHREAD_MUTEX_INITIALIZER: pthread_mutex_t ({0})

# signals & process
SIGKILL: int (9)
SIGTERM: int (15)
WEXITSTATUS: macro(int status) -> int
